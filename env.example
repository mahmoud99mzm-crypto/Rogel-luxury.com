# انسخ هذا الملف إلى .env للتجربة المحلية، وضع نفس القيم في Vercel -> Settings -> Environment Variables

# مفتاح عميل جوجل (Google OAuth 2.0 Web Client ID)
# مثال: 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# كلمة سر المشرف تُضبط من لوحة Vercel ولا تُكتب داخل الكود
ADMIN_PASSWORD=

# اختياري: مفتاح سري إضافي لتوقيع جلسة المشرف
ADMIN_SESSION_SECRET=
